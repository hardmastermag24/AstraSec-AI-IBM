# ============================================================
# AstraSec AI — Plantilla de variables de entorno
# Copia este archivo como .env y completa tus credenciales.
# NUNCA subas .env a control de versiones.
# ============================================================

# Proveedor de IA activo:
#   demo     → Sin IA real. Respuestas ficticias etiquetadas [MODO DEMO]. (default)
#   watsonx  → IBM watsonx.ai via SDK ibm-watsonx-ai. Requiere las variables WATSONX_* abajo.
AI_PROVIDER=demo

# ============================================================
# IBM watsonx.ai  (requiere AI_PROVIDER=watsonx)
# ============================================================

# API Key de IBM Cloud.
# Cómo obtenerla: IBM Cloud → Gestionar → Acceso (IAM) → Claves de API → Crear
# WATSONX_API_KEY=

# URL del servicio watsonx.ai según la región de tu instancia:
#   Dallas    → https://us-south.ml.cloud.ibm.com
#   Frankfurt → https://eu-de.ml.cloud.ibm.com
#   London    → https://eu-gb.ml.cloud.ibm.com
#   Tokyo     → https://jp-tok.ml.cloud.ibm.com
#   Sydney    → https://au-syd.ml.cloud.ibm.com
#   Toronto   → https://ca-tor.ml.cloud.ibm.com
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ID del proyecto de Watson Studio.
# Cómo obtenerlo: watsonx.ai → abre tu proyecto → URL del navegador → ?projectid=<ID>
#   O bien: Manage → General → Project ID (en la pestaña del proyecto)
# WATSONX_PROJECT_ID=

# ID del modelo a usar. Ejemplos verificados:
#   ibm/granite-3-3-8b-instruct      (recomendado — eficiente y en español)
#   ibm/granite-3-3-2b-instruct      (más ligero)
#   meta-llama/llama-3-3-70b-instruct
# Lista completa: https://cloud.ibm.com/apidocs/watsonx-ai#list-foundation-model-specs
# WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# ============================================================
# Configuración de recuperación de contexto (RAG)
# ============================================================

# Número máximo de fragmentos de contexto enviados al agente por consulta
MAX_CONTEXT_CHUNKS=5

# Tamaño máximo de fragmento en caracteres
CHUNK_SIZE=1500

# Solapamiento entre fragmentos consecutivos en caracteres
CHUNK_OVERLAP=200
